# Copy to backend/.env and fill in. Never commit the real .env.

# JWT signing secrets: 32+ random characters each, and different from each other.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes: seconds, or a number with s / m / h / d.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mark auth cookies Secure (HTTPS only). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# NODE_ENV=production
# PORT=4000
